# Append the needed values to backend/.env. This example contains no credentials.
# Base URL is the prefix immediately before /chat/completions, e.g. https://provider.example/v1.
JOURNEY_LLM_API_KEY=
JOURNEY_LLM_BASE_URL=
JOURNEY_LLM_MODEL=
# Set true only for a model that supports image_url content AND JSON-object responses.
JOURNEY_LLM_VISION=false

# AMap Web Service key, independent of the JS SDK security code.
AMAP_WEB_SERVICE_KEY=
# Enable only when your provider agreement covers this storage / export use.
AMAP_JOURNAL_STORAGE_ALLOWED=false
AMAP_EXPORT_ALLOWED=false

# Offline export only; not required for collecting opt-in feedback.
TRAINING_LOCAL_PLACE_DATA_ALLOWED=false
FEEDBACK_EXPORT_SECRET=
