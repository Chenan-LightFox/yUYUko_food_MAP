PORT=7000
HOST=127.0.0.1
JWT_SECRET=replace-with-a-long-random-value

# Structured JSON logs (paths are relative to backend/ unless absolute)
LOG_LEVEL=info
LOG_DIR=logs
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_PRETTY_CONSOLE=true
LOG_MAX_FILE_MB=20
LOG_RETENTION_DAYS=14
LOG_SLOW_REQUEST_MS=1500
DB_SLOW_QUERY_MS=100
DB_BUSY_TIMEOUT_MS=5000
# Successful requests under these prefixes are omitted to avoid tile/image log noise.
# Errors and slow requests are still logged.
LOG_NOISY_PATH_PREFIXES=/_AMapService,/uploads,/diagnostics/client-auth

# Semantic search (server-side only; never expose these as VITE_ variables)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_TIMEOUT_MS=15000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_EXPANSION_TIMEOUT_MS=6000
INTENT_EXPANSION_CACHE_TTL_MS=3600000

# Vector backfill/retry worker
VECTOR_AUTO_BACKFILL=true
VECTOR_BATCH_SIZE=20
VECTOR_RETRY_INTERVAL_MS=600000

# Public AI-search protection
AI_SEARCH_RATE_LIMIT=12
AI_SEARCH_MIN_SEMANTIC_SCORE=0.60
AI_EXPANDED_INTENT_MIN_SEMANTIC_SCORE=0.55
AI_PLACE_DETAIL_WEIGHT=0.25
AI_RELEVANCE_MIN_CONFIDENCE=0.68
AI_FALLBACK_RELEVANCE_MIN_SCORE=0.58
AI_LOCAL_PREFERENCE_MIN_SCORE=0.60
AI_LOCAL_MIN_DETAIL_COMPLETENESS=0.25
AI_REMOTE_SEARCH_RADIUS_KM=50
AI_REMOTE_PROXIMITY_WEIGHT=0.06
